# Remote MCP Cloudflare Worker URLs live in wrangler.jsonc.
# Studio overrides (prefer private local OAuth; never commit credentials):
# NUWA_RELAY_URL=https://agent-relay.company-notes.com
# NUWA_ADDRESS_URL=https://address.company-notes.com
# NUWA_MCP_HOME=<absolute-local-directory>
# NUWA_WORK_ADDRESS_ID=<owned Work UUID>
# NUWA_ACCESS_TOKEN=<only for headless runs; don't commit>
