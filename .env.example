ADDRESS_API_URL=https://address.company-notes.com
RELAY_API_URL=https://agent-relay.company-notes.com

# GitHub secret: CLOUDFLARE_API_TOKEN
# GitHub secret: CLOUDFLARE_ACCOUNT_ID
# GitHub variable: CLOUDFLARE_CUSTOM_DOMAIN=agent-relay-mcp.company-notes.com
# GitHub variable: CLOUDFLARE_WORKER_NAME=nuwa-agent-relay-mcp
# GitHub variable: MCP_DEPLOY_ENABLED=true (optional; default false)

# Local Studio per-profile config, never commit real tokens:
# NUWA_MCP_PROFILE=default
# NUWA_MCP_HOME=/absolute/private/path
# NUWA_ACCESS_TOKEN=only-for-noninteractive-test-accounts
# NUWA_WORK_ID=work-uuid
