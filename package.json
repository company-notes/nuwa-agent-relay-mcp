{
  "name": "@company-notes/nuwa-agent-relay-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local stdio MCP server for Nuwa Agent Relay using Agent Address OAuth",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "login": "node src/cli.mjs login",
