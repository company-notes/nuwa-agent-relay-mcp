{
  "name": "@company-notes/nuwa-agent-relay-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare remote MCP resource server and separate Python FastMCP Studio adapter",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "style:check": "node scripts/check-code-principles.mjs",
    "test": "node --import tsx --test server/test/*.test.ts && node --test scripts/GuardBindingD1.checks.mjs",
    "build": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "deploy": "node scripts/GuardBindingD1.mjs --remote --require-migrated && wrangler deploy --config .wrangler.deploy.jsonc",
    "audit:check": "npm audit --audit-level=high",
    "db:migrate:local": "wrangler d1 migrations apply BINDINGS_DB --local",
    "db:migrate:remote": "node scripts/GuardBindingD1.mjs --remote && wrangler d1 migrations apply BINDINGS_DB --remote --config .wrangler.deploy.jsonc",
    "test:d1:local": "npm run db:migrate:local && node scripts/VerifyLocalBindingsD1.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.38.0",
    "tsx": "^4.20.0"
  }
}
