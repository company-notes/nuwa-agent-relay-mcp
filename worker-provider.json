{
  "tools": [
    "fleet_status",
    "fleet_projects",
    "fleet_models",
    "work_list",
    "work_status",
    "work_messages",
    "work_feed",
    "work_start",
    "work_continue",
    "worker_workspace_ensure",
    "worker_task_plan",
    "worker_task_start",
    "worker_delivery_open",
    "worker_notification_status"
  ],
  "identityTools": [
    "work_start",
    "worker_task_start",
    "work_continue",
    "worker_notification_status"
  ],
  "assistantIdentitySchema": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": [
          "bot",
          "agentAddress"
        ]
      },
      "platform": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "botId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,256}$"
      },
      "address": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "required": [
      "type"
    ],
    "additionalProperties": false,
    "description": "Your own stable Bot ID (type=bot, platform, botId), or canonical Agent Address (type=agentAddress, address). Use your actual identity, not another assistant's."
  }
}
